{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Authenticated user account profile (Worker, Owner, or Founder Super Admin) isolated by Firebase UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "mobile": { "type": "string", "maxLength": 10 },
        "mobileE164": { "type": "string", "maxLength": 15 },
        "email": { "type": "string", "maxLength": 160 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "enum": ["WORKER", "OWNER", "SUPER_ADMIN"] },
        "accountStatus": { "type": "string", "enum": ["ACTIVE", "SUSPENDED", "DEACTIVATED"] },
        "statusReason": { "type": "string", "maxLength": 300 },
        "isFounder": { "type": "boolean" },
        "language": { "type": "string", "enum": ["hi", "en"] },
        "theme": { "type": "string", "enum": ["light", "dark"] },
        "employerUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "role", "language", "theme", "createdAt", "updatedAt"]
    },
    "SuperAdminRegistry": {
      "title": "SuperAdminRegistry",
      "description": "Read-only registry of verified Founder Super Admin UIDs. Strictly immutable from client SDKs.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "founderName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "roleTitle": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "maxLength": 160 }
      },
      "required": ["uid", "founderName"]
    },
    "AppSettings": {
      "title": "AppSettings",
      "description": "Global platform configuration, subscription quotas, and premium feature flags controlled exclusively by Super Admin Raja.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "enum": ["global"] },
        "appName": { "type": "string", "maxLength": 80 },
        "founderName": { "type": "string", "maxLength": 80 },
        "maintenanceMode": { "type": "boolean" },
        "registrationEnabled": { "type": "boolean" },
        "freePlanWorkerLimit": { "type": "number" },
        "proPlanWorkerLimit": { "type": "number" },
        "proPlanPriceInr": { "type": "number" },
        "enterprisePlanPriceInr": { "type": "number" },
        "supportContact": { "type": "string", "maxLength": 160 },
        "announcementBanner": { "type": "string", "maxLength": 300 },
        "gpsGeofencing": { "type": "boolean" },
        "pdfExcelExports": { "type": "boolean" },
        "whatsappIntegration": { "type": "boolean" },
        "multiSiteManagement": { "type": "boolean" },
        "cloudBackupRestore": { "type": "boolean" },
        "customBranding": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "appName", "founderName", "maintenanceMode", "registrationEnabled", "updatedAt"]
    },
    "EmployerOrg": {
      "title": "EmployerOrg",
      "description": "Employer organization profile owned by an OWNER user with Super Admin controlled subscription tier and account status.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "businessName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "ownerName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "mobile": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{10}$" },
        "address": { "type": "string", "maxLength": 240 },
        "accountStatus": { "type": "string", "enum": ["ACTIVE", "SUSPENDED", "DEACTIVATED"] },
        "subscriptionPlan": { "type": "string", "enum": ["FREE", "PRO", "ENTERPRISE"] },
        "subscriptionExpiresAt": { "type": "string", "maxLength": 30 },
        "maxWorkers": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerUid", "businessName", "ownerName", "mobile", "createdAt", "updatedAt"]
    },
    "WorkSite": {
      "title": "WorkSite",
      "description": "Work site with optional GPS geofence managed by an employer.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "employerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "location": { "type": "string", "maxLength": 200 },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "radiusMeters": { "type": "number" },
        "status": { "type": "string", "enum": ["ACTIVE", "COMPLETED", "PAUSED"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "employerUid", "name", "radiusMeters", "status", "createdAt", "updatedAt"]
    },
    "WorkerProfile": {
      "title": "WorkerProfile",
      "description": "Worker employment record linking an employer organization and a worker.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uniqueWorkerId": { "type": "string", "minLength": 4, "maxLength": 40 },
        "employerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "employerName": { "type": "string", "maxLength": 160 },
        "employerMobile": { "type": "string", "maxLength": 15 },
        "workerUid": { "type": "string", "maxLength": 128 },
        "siteId": { "type": "string", "maxLength": 128 },
        "siteName": { "type": "string", "maxLength": 120 },
        "siteLat": { "type": "number" },
        "siteLng": { "type": "number" },
        "siteRadiusMeters": { "type": "number" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "mobile": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{10}$" },
        "mobileE164": { "type": "string", "minLength": 13, "maxLength": 13, "pattern": "^\\+91[0-9]{10}$" },
        "photoUrl": { "type": "string", "maxLength": 200000 },
        "skillRole": { "type": "string", "minLength": 1, "maxLength": 80 },
        "wageType": { "type": "string", "enum": ["DAILY", "MONTHLY"] },
        "dailyWage": { "type": "number" },
        "monthlySalary": { "type": "number" },
        "overtimeRate": { "type": "number" },
        "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] },
        "joinedAt": { "type": "string", "maxLength": 20 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "uniqueWorkerId",
        "employerUid",
        "name",
        "mobile",
        "mobileE164",
        "skillRole",
        "wageType",
        "dailyWage",
        "monthlySalary",
        "overtimeRate",
        "status",
        "joinedAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Date-wise worker attendance record with overtime, GPS verification, and edit history.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workerUid": { "type": "string", "maxLength": 128 },
        "workerMobileE164": { "type": "string", "minLength": 13, "maxLength": 13, "pattern": "^\\+91[0-9]{10}$" },
        "employerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "siteId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "month": { "type": "string", "minLength": 7, "maxLength": 7, "pattern": "^[0-9]{4}-[0-9]{2}$" },
        "status": { "type": "string", "enum": ["PRESENT", "ABSENT", "HALF_DAY", "PAID_LEAVE"] },
        "hoursWorked": { "type": "number" },
        "overtimeHours": { "type": "number" },
        "gpsLat": { "type": "number" },
        "gpsLng": { "type": "number" },
        "gpsVerified": { "type": "boolean" },
        "markedByUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "markedByRole": { "type": "string", "enum": ["OWNER", "WORKER"] },
        "editReason": { "type": "string", "maxLength": 300 },
        "editHistory": { "type": "array" },
        "notes": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "workerId",
        "workerMobileE164",
        "employerUid",
        "date",
        "month",
        "status",
        "hoursWorked",
        "overtimeHours",
        "gpsVerified",
        "markedByUid",
        "markedByRole",
        "createdAt",
        "updatedAt"
      ]
    },
    "SalarySummary": {
      "title": "SalarySummary",
      "description": "Monthly aggregated payroll calculation for a worker.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workerUid": { "type": "string", "maxLength": 128 },
        "workerMobileE164": { "type": "string", "minLength": 13, "maxLength": 13 },
        "employerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "month": { "type": "string", "minLength": 7, "maxLength": 7, "pattern": "^[0-9]{4}-[0-9]{2}$" },
        "effectiveDailyWage": { "type": "number" },
        "presentDays": { "type": "number" },
        "halfDays": { "type": "number" },
        "paidLeaveDays": { "type": "number" },
        "absentDays": { "type": "number" },
        "totalWorkingDays": { "type": "number" },
        "totalHours": { "type": "number" },
        "overtimeHours": { "type": "number" },
        "attendanceEarnings": { "type": "number" },
        "overtimeEarnings": { "type": "number" },
        "bonusTotal": { "type": "number" },
        "deductionTotal": { "type": "number" },
        "totalSalary": { "type": "number" },
        "advanceTotal": { "type": "number" },
        "paidTotal": { "type": "number" },
        "remainingBalance": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "workerId", "workerMobileE164", "employerUid", "month", "totalSalary", "remainingBalance", "updatedAt"]
    },
    "FinancialTransaction": {
      "title": "FinancialTransaction",
      "description": "Immutable financial transaction for payments, advances, bonuses, deductions, and site expenses.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "category": { "type": "string", "enum": ["PAYMENT", "ADVANCE", "BONUS", "DEDUCTION", "EXPENSE"] },
        "employerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "workerId": { "type": "string", "maxLength": 128 },
        "workerUid": { "type": "string", "maxLength": 128 },
        "workerMobileE164": { "type": "string", "maxLength": 15 },
        "workerName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "uniqueWorkerId": { "type": "string", "maxLength": 40 },
        "siteId": { "type": "string", "maxLength": 128 },
        "amount": { "type": "number" },
        "mode": { "type": "string", "enum": ["CASH", "UPI", "BANK", "ADJUSTMENT", "SITE"] },
        "referenceNo": { "type": "string", "maxLength": 80 },
        "date": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "month": { "type": "string", "minLength": 7, "maxLength": 7, "pattern": "^[0-9]{4}-[0-9]{2}$" },
        "time": { "type": "string", "minLength": 4, "maxLength": 10 },
        "description": { "type": "string", "maxLength": 300 },
        "recordedByUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "category", "employerUid", "workerName", "amount", "mode", "date", "month", "time", "recordedByUid", "createdAt"]
    },
    "LeaveRequest": {
      "title": "LeaveRequest",
      "description": "Worker leave request approved or rejected by the employer.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "workerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "workerMobileE164": { "type": "string", "minLength": 13, "maxLength": 13 },
        "workerName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "uniqueWorkerId": { "type": "string", "maxLength": 40 },
        "employerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "fromDate": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "toDate": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 300 },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED"] },
        "ownerNote": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "workerId", "workerUid", "workerMobileE164", "workerName", "employerUid", "fromDate", "toDate", "reason", "status", "createdAt", "updatedAt"]
    },
    "NotificationItem": {
      "title": "NotificationItem",
      "description": "Bilingual in-app notification delivered to a worker on attendance or payment changes.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "employerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "workerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "workerUid": { "type": "string", "maxLength": 128 },
        "workerMobileE164": { "type": "string", "minLength": 13, "maxLength": 13 },
        "type": { "type": "string", "minLength": 1, "maxLength": 40 },
        "titleEn": { "type": "string", "minLength": 1, "maxLength": 140 },
        "titleHi": { "type": "string", "minLength": 1, "maxLength": 140 },
        "messageEn": { "type": "string", "minLength": 1, "maxLength": 400 },
        "messageHi": { "type": "string", "minLength": 1, "maxLength": 400 },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "employerUid", "workerId", "workerMobileE164", "type", "titleEn", "titleHi", "messageEn", "messageHi", "isRead", "createdAt", "updatedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable organization audit trail for attendance edits and financial entries.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "employerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "workerId": { "type": "string", "maxLength": 128 },
        "actorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "actorName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "actorRole": { "type": "string", "enum": ["OWNER", "WORKER", "SUPER_ADMIN"] },
        "action": { "type": "string", "minLength": 1, "maxLength": 80 },
        "entityType": { "type": "string", "minLength": 1, "maxLength": 60 },
        "entityId": { "type": "string", "maxLength": 128 },
        "reason": { "type": "string", "maxLength": 300 },
        "summary": { "type": "string", "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "employerUid", "actorUid", "actorName", "actorRole", "action", "entityType", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/entities/UserAccount",
      "description": "Private user account documents indexed by Firebase Auth UID."
    },
    "/super_admins/{adminId}": {
      "schema": "#/entities/SuperAdminRegistry",
      "description": "Immutable server-managed registry of Founder Super Admin accounts."
    },
    "/app_settings/{settingId}": {
      "schema": "#/entities/AppSettings",
      "description": "Global platform configuration and feature flags controlled by Founder Raja."
    },
    "/employers/{employerId}": {
      "schema": "#/entities/EmployerOrg",
      "description": "Employer organization profiles indexed by owner UID."
    },
    "/work_sites/{siteId}": {
      "schema": "#/entities/WorkSite",
      "description": "Work sites belonging to an employer."
    },
    "/workers/{workerId}": {
      "schema": "#/entities/WorkerProfile",
      "description": "Worker records scoped to an employerUid and linked workerUid/mobileE164."
    },
    "/attendance/{attendanceId}": {
      "schema": "#/entities/AttendanceRecord",
      "description": "Daily attendance records; workers have read-only access except initial GPS self check-in."
    },
    "/salaries/{salaryId}": {
      "schema": "#/entities/SalarySummary",
      "description": "Monthly salary calculation summaries per worker."
    },
    "/transactions/{txId}": {
      "schema": "#/entities/FinancialTransaction",
      "description": "Immutable financial ledger entries (payments, advances, bonuses, deductions, expenses)."
    },
    "/leave_requests/{leaveId}": {
      "schema": "#/entities/LeaveRequest",
      "description": "Leave requests submitted by workers and reviewed by employers."
    },
    "/notifications/{notifId}": {
      "schema": "#/entities/NotificationItem",
      "description": "Bilingual notifications for workers."
    },
    "/audit_logs/{logId}": {
      "schema": "#/entities/AuditLog",
      "description": "Immutable organization audit trail."
    }
  }
}
