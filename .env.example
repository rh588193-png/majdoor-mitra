# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key for signing OTP authentication cookies/tokens.
SESSION_SECRET="change-me-in-production"

# FOUNDER / SUPER ADMIN CONFIGURATION (Configurable at deployment; never hardcode passwords)
FOUNDER_NAME="Raja"
FOUNDER_EMAIL="rh588193@gmail.com"
# Optional 10-digit Indian mobile number to lock Founder login at deployment
FOUNDER_MOBILE=""
# Optional scrypt hash formatted as "<32-char-hex-salt>:<128-char-hex-derived-key>"
FOUNDER_PASSKEY_HASH=""
# Optional one-time setup token required if configuring Founder interactively on first boot
FOUNDER_BOOTSTRAP_SECRET=""

